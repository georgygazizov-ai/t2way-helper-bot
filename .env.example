# Токен бота MAX.
# В документации maxapi переменная называется MAX_BOT_TOKEN.
MAX_BOT_TOKEN=

# ID root-пользователей MAX.
# Если несколько ID, указывать через запятую.
# Пример: ROOT_USER_IDS=123456,789012
ROOT_USER_IDS=

# ID общего чата T2Way.
# Пока можно оставить пустым.
# Реальную проверку общего чата будем делать в самом конце.
COMMON_CHAT_ID=

# Окружение приложения.
# development / production
APP_ENV=development

# Режим проверки участия в общем чате.
# dev_always_true — заглушка (все регистрируются).
# real — реальная проверка через MAX API.
MEMBERSHIP_MODE=dev_always_true

# Часовой пояс проекта.
TIMEZONE=Europe/Moscow

# Пути внутри проекта.
DB_PATH=data/t2way.sqlite3
LOG_DIR=logs
BACKUP_DIR=backups

# Удалять ли предыдущие сообщения бота в многошаговых формах.
DELETE_PREVIOUS_BOT_MESSAGES=true

# Ограничение размера файлов для будущих рассылок, в МБ.
MAX_FILE_SIZE_MB=15

# Пауза между сообщениями при рассылке.
# 0.5 секунды = 2 сообщения в секунду.
BROADCAST_DELAY_SECONDS=0.5

# Ссылка на материалы тренера (внешний сайт)
TRAINER_MATERIALS_URL=https://example.com